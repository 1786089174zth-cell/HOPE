# CAD exchange assets. Keep opaque in PR diffs and whitespace checks.
*.x_t binary linguist-generated=true

# Original Motive exports are byte-exact provenance; retain their Windows CRLF.
agibot/mocap_sticker_shell_v3/motive_asset/source/A3.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
agibot/mocap_sticker_shell_v3/motive_asset/source/A3.motive -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Generated documents. Review rendered output instead of binary internals.
