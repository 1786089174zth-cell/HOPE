@@ -28,6 +28,13 @@
 
 struct IncomingTrajectoryConfig {
   double net_x = 1.37;
+  // Where a commit may first be considered, if not at the net (NaN = net_x). A fast
+  // ball needs 0.22-0.30 s from the net to the strike plane: gated at the net it can
+  // never get the 0.405 s reserve. With a finite gate the flight is eligible as soon
+  // as it is inside it (a ball first seen inside passes at once); net_x keeps deciding
+  // what the opponent's side is. The hit-deadline clock is unchanged, so slow balls
+  // are committed exactly when they were.
+  double commit_gate_x = std::numeric_limits<double>::quiet_NaN();
   double estimator_window_s = 0.18;
   double estimator_max_sample_gap_s = 0.0;
   double commit_delay_s = 0.05;
